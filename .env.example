SERVER_PORT=8080
SERVER_HOST_PORT=8080

DB_USER=postgres
DB_HOST=localhost
DB_NAME=db_name
DB_PASSWORD=password
DB_PORT=5432
DB_HOST_PORT=8001
DB_CONNECTION_STRING=postgresql://postgres:password@localhost:8001/db_name
# Local development only: reset schema by dropping public, rerunning migrations, and reseeding test data
DB_RESET_ON_START=false
# Local development only: seed test data when DB is empty
DB_SEED_ON_START=false