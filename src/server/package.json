{
  "name": "foodily-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon --ext ts --exec \"npm run build && node dist/app.js\"",
    "dev:server-pages": "cross-env SERVER_UI=server-pages npm run dev",
    "dev:no-auth": "cross-env SERVER_AUTH=false SERVER_UI=none nodemon --ext ts --exec \"npm run build:api-only && node dist/app.js\"",
    "build": "npm run clean && tsc --build && tsc-alias && npm run copy-files",
    "build:api-only": "tsc --build && tsc-alias",
    "migrate": "node-pg-migrate --database-url-var DB_CONNECTION_STRING --envPath ../../.env -m migrations",
    "migrate:create": "npm run migrate -- create",
    "migrate:up": "npm run migrate -- up",
    "migrate:down": "npm run migrate -- down",
    "migrate:redo": "npm run migrate -- redo",
    "clean": "npx rimraf dist",
    "copy-files": "copyfiles -u 1 src/**/*.html src/**/*.css dist/",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path ../../.gitignore"
  },
  "dependencies": {
    "@types/swagger-ui-express": "^4.1.8",
    "argon2": "^0.44.0",
    "body-parser": "^2.2.2",
    "connect-ensure-login": "^0.1.1",
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.20.0",
    "swagger-ui-express": "^5.0.1",
    "node-pg-migrate": "^8.0.3"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.6",
    "@types/connect-ensure-login": "^0.1.9",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/express-session": "^1.19.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.12.4",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "copyfiles": "^2.4.1",
    "eslint": "^9.39.4",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3"
  }
}
